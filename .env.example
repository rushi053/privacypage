# Env var names read by src/ (scripts read none). Copy to .env.local and fill locally. Leave these values empty.

# Resend API key. Sends the license email after a purchase. Missing key skips the email.
RESEND_API_KEY=

# OpenRouter key. First provider in document generation (moonshotai/kimi-k2.5).
OPENROUTER_API_KEY=

# Anthropic key. Fallback provider when OpenRouter returns nothing.
ANTHROPIC_API_KEY=

# Supabase project URL. Required for server-side document storage and the paywall.
SUPABASE_URL=

# Supabase service-role key. Server-only; used for RLS-locked tables.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase anon key. Server fallback when the service-role key is unset.
SUPABASE_ANON_KEY=

# Razorpay key id. Server-side order creation and purchase redemption.
RAZORPAY_KEY_ID=

# Razorpay key secret. Server-side order creation, payment verify, and redemption.
RAZORPAY_KEY_SECRET=

# Razorpay webhook signing secret. Verifies payment.captured payloads.
RAZORPAY_WEBHOOK_SECRET=

# Razorpay key id exposed to the browser checkout widget.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
