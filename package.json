{
  "name": "privacypage",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/validate-platforms.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/validate-sitemap.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/validate-links.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "validate:platforms": "node scripts/validate-platforms.mjs",
    "validate:sitemap": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/validate-sitemap.mjs",
    "validate:links": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/validate-links.mjs",
    "validate:urls": "node scripts/validate-platforms.mjs --check-urls",
    "check:doc-request": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test scripts/check-doc-request.mjs",
    "check:currency": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test scripts/check-currency.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "next": "^15.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "resend": "^6.25.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.8",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.4",
    "postcss": "^8.5.4",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3"
  }
}
